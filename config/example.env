# Go web service
WEBSIDEBAND_LISTEN_ADDRESS=:8080
LXMF_BRIDGE_URL=http://reticulum:8081
WEBSIDEBAND_DATA_DIR=/data
# Optional built-in HTTPS. Mount both files read-only into the Go container.
WEBSIDEBAND_TLS_CERT_FILE=
WEBSIDEBAND_TLS_KEY_FILE=
# Authentication is required by default. Set true only behind another trusted auth layer.
WEBSIDEBAND_AUTH_DISABLED=false

# Set the same random value on both containers.
LXMF_BRIDGE_TOKEN=replace-with-a-long-random-value

# Python LXMF bridge
LXMF_BRIDGE_LISTEN_ADDRESS=0.0.0.0
LXMF_BRIDGE_PORT=8081
LXMF_DATA_DIR=/data
LXMF_DISPLAY_NAME=PEREVIA
LXMF_ANNOUNCE_AT_START=true
LXMF_PATH_TIMEOUT_SECONDS=30
RNS_SHARED_INSTANCE_PORT=37428
RNS_INSTANCE_CONTROL_PORT=37429
RNS_RPC_KEY=replace-with-the-same-hex-rpc-key-configured-in-rnsd
